#include<bits/stdc++.h>
using namespace std;
 
int main ()
{
    int n;
    string s;
    cin>>s;
    for(int i=0; i<s.size(); i++)
    {
        if (s[i]=='+')n++;
    }
 
    sort(s.begin(),s.end());
 
    cout<<s[n];
    for (int i=n+1; i<s.size(); i++)
    {
        cout << "+"<<s[i];
    }
 
    cout << endl;
 
    return 0;
}
