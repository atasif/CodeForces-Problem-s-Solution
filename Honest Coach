#include <bits/stdc++.h>
using namespace std;
 
int main()
{
	int test;
	cin>>test;
 
	for(int t=1; t<=test; t++) {
		int n;
		cin>>n;
		vector<int>v(n);
		for(int i=0; i<n; i++) {	
			cin>> v[i];
		}
 
		sort(v.begin(),v.end());
		int lest=1000;
		for(int i=1; i<v.size(); i++) {
			lest=min(lest,v[i]-v[i-1]);
		}
		cout << lest<<endl;
	}
 
	return 0;
}
