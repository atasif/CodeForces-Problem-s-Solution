#include<bits/stdc++.h>
using namespace std;
 
int main ()
{
    int m[5][5];
    for (int i=0; i<5; i++)
    {
        for (int j=0; j<5; j++)
        {
            cin >>m[i][j];
        }
    }
    int k,l;
    for (int i=0; i<5; i++)
    {
        for (int j=0; j<5; j++)
        {
            if(m[i][j]!=0)
            {
                k=i;
                l=j;
                goto last;
            }
        }
    }
last:
    cout<< abs(2-k)+abs(2-l)<<endl;
 
    return 0;
}
