#include<bits/stdc++.h>
using namespace std;
bool  lucky_number(int n){
    int flag=0, nm[14]={4,7,44,47,74,77,444,447,474,477,744,747,774,777};
    for(int i=0;i<14;i++){
        if(n%nm[i]==0){
            flag++;
            break;
        }
    }
    if (flag==1) return true;
    else return false ;   
}
int main () { 
	int m;
	cin>>m;
if(lucky_number(m)) cout<< "YES"<<endl;
else cout << "NO"<<endl;
 
	return 0;
}
