#include<bits/stdc++.h>
using namespace std;
 
int main ()
{
    int test;
    cin>>test;
    int a=0,d=0;
    for (int i=1; i<=test; i++)
    {
        char c;
        cin>>c;
        if(c=='A')a++;
        else d++;
    }
    if(a>d) cout << "Anton\n";
    else if(a<d) cout << "Danik\n";
    else cout << "Friendship\n";
 
    return 0;
}
