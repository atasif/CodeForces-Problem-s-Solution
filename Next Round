#include<bits/stdc++.h>
using namespace std;
 
int main ()
{
    int test,x,r=0;
    cin>>test>>x;
int n[test];
    for (int i=0; i<test; i++)
    {
        cin>>n[i];
    }
    int k=n[x-1];
    for (int i=0; i<test; i++)
    {
        if(n[i]>=k&&n[i]!=0) r++;
    }
    cout <<r<<endl;
        return 0;
}
