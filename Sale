#include <bits/stdc++.h>
using namespace std;
 
int main()
{
	int n,m,sum=0;
	cin>>n>>m;
	int array[n];
	for(int i=0; i<n; i++) {
		cin>>array[i];
	}
	vector<int>v;
	for (int i=0; i<n; i++ ) {
 
		if(array[i]<0) v.push_back(array[i]);
 
	}
	sort(v.begin(),v.end());
	vector<int>::iterator it;
	int si=v.size();
	int mi =min(si,m);
	for(it=v.begin(); it!=v.begin()+mi; it++) {
		sum=sum+*it;
	}
	cout << sum*-1<<endl;
	return 0;
}
