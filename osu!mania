#include<bits/stdc++.h>
using namespace std;
 
int main ()
{
    int test ;
    cin>>test;
    while (test)
    {
        int n;
        cin >> n;
 
        vector<int> columns(n);
 
        for (int i = 0; i < n; i++) {
            string row;
            cin >> row;
 
            for (int j = 0; j < row.length(); j++) {
                if (row[j] == '#') {
                    columns[n - i - 1] = j + 1;
                    break;
                }
            }
        }
 
        for (int i = 0; i < n; i++) {
            cout << columns[i] << " ";
        }
        cout << endl;
 
        test--;
    }
 
    return 0;
}
