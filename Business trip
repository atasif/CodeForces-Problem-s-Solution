#include<bits/stdc++.h>
using namespace std;
int main (){
 
int k,arr[12],sum=0,need=0;
cin>>k;
for(int i=0;i<12;i++){
    cin>>arr[i];
    sum+=arr[i];
}
sort(arr,arr+12);
if(sum<k) cout<< "-1"<<endl;
else if(k==0) cout<< "0"<<endl;
else {
    for (int i=11;i>=0;i--){
        k=k-arr[i];
        need++;
        if(k<=0){
            cout<< need<<endl;
            break;
        }
    }
}
 
return 0;
}
