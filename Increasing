#include<bits/stdc++.h>
using namespace std;
int main ()
{
    int test;
    cin>> test;
    for(int i=0; i<test; i++)
    {
        int si;
        cin>> si;
         int arr[si];
        for (int j=0; j<si; j++)
        {
            cin>> arr[j];
        }
        sort(arr+0,arr+si);
        int flag=0;
        for (int k=0; k<si-1; k++)
        {
            if(arr[k]>=arr[k+1])
            {
                flag++;
                break;
            }
        }
        if(flag==0)cout<< "YES" <<endl;
        else if (flag>0) cout << "NO"<< endl;
    } 
    return 0;
}
